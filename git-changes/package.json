{
  "name": "git-changes",
  "displayName": "Git Changes",
  "description": "A sidebar of the files of a chosen diff, as a tree: the uncommitted changes, the last commit, the branch compared to main, or a commit.",
  "version": "0.1.0",
  "publisher": "tleruitte",
  "repository": {
    "type": "git",
    "url": "https://github.com/tleruitte/vscode-extensions.git",
    "directory": "git-changes"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "diff",
    "changes",
    "review",
    "pull request"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitChanges",
          "title": "Git Changes",
          "icon": "images/git-changes.svg"
        }
      ]
    },
    "views": {
      "gitChanges": [
        {
          "id": "gitChanges.files",
          "name": "Git Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "gitChanges.choose",
        "title": "Choose the Diff",
        "category": "Git Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitChanges.chooseInRepo",
        "title": "Choose a Commit of the Repository",
        "category": "Git Changes",
        "icon": "$(git-commit)"
      },
      {
        "command": "gitChanges.open",
        "title": "Open"
      },
      {
        "command": "gitChanges.openDiff",
        "title": "Open Changes",
        "category": "Git Changes",
        "icon": "$(diff)"
      },
      {
        "command": "gitChanges.openFile",
        "title": "Open File",
        "category": "Git Changes",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitChanges.hideTests",
        "title": "Hide Test Files",
        "category": "Git Changes",
        "icon": "$(filter)"
      },
      {
        "command": "gitChanges.showTests",
        "title": "Show Test Files",
        "category": "Git Changes",
        "icon": "$(filter-filled)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitChanges.open",
          "when": "false"
        },
        {
          "command": "gitChanges.openDiff",
          "when": "false"
        },
        {
          "command": "gitChanges.chooseInRepo",
          "when": "false"
        },
        {
          "command": "gitChanges.openFile",
          "when": "false"
        },
        {
          "command": "gitChanges.hideTests",
          "when": "!gitChanges.testsHidden"
        },
        {
          "command": "gitChanges.showTests",
          "when": "gitChanges.testsHidden"
        }
      ],
      "view/title": [
        {
          "command": "gitChanges.hideTests",
          "when": "view == gitChanges.files && !gitChanges.testsHidden",
          "group": "navigation@0"
        },
        {
          "command": "gitChanges.showTests",
          "when": "view == gitChanges.files && gitChanges.testsHidden",
          "group": "navigation@0"
        },
        {
          "command": "gitChanges.choose",
          "when": "view == gitChanges.files",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gitChanges.chooseInRepo",
          "when": "view == gitChanges.files && viewItem == gitChangesRepo",
          "group": "inline@1"
        },
        {
          "command": "gitChanges.openDiff",
          "when": "view == gitChanges.files && viewItem == gitChangesFile",
          "group": "inline@1"
        },
        {
          "command": "gitChanges.openFile",
          "when": "view == gitChanges.files && viewItem == gitChangesDiffFile",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Git Changes",
      "properties": {
        "gitChanges.hideTestFiles": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Hide the test files in the list of Git Changes. The button in the title of Git Changes changes it, for all the windows."
        },
        "gitChanges.testFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.test.*",
            "**/*.spec.*",
            "**/__tests__/**",
            "**/test/**",
            "**/tests/**",
            "**/__snapshots__/**",
            "**/__mocks__/**"
          ],
          "scope": "resource",
          "markdownDescription": "The test files that the filter of Git Changes hides, as glob patterns of the paths from the root of the repository: `**` for any folders, `*` and `?` in one name, and `{a,b}` for one of the alternatives. A value replaces the default list."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\"",
    "package": "npx @vscode/vsce package --out releases"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
