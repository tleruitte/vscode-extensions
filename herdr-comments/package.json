{
  "name": "herdr-comments",
  "displayName": "Herdr Comments",
  "description": "Comments on lines of code, sent to the coding agent that works on the folder in Herdr.",
  "version": "0.3.0",
  "publisher": "tleruitte",
  "repository": {
    "type": "git",
    "url": "https://github.com/tleruitte/vscode-extensions.git",
    "directory": "herdr-comments"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "herdr",
    "agent",
    "review",
    "comments",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Herdr Comments",
      "properties": {
        "herdrComments.agent": {
          "type": "string",
          "default": "claude",
          "description": "The agent that Herdr starts with the comments when no agent works in the folder, as a command (for example `claude` or `codex`)."
        },
        "herdrComments.sendImmediately": {
          "type": "boolean",
          "default": true,
          "description": "Send each comment to the agent when you save it, without Submit. When the agent waits for your answer to a prompt in Herdr, the comment waits and goes after the answer. Turn it off to keep the comments pending and send them as one review with Submit."
        },
        "herdrComments.chat": {
          "type": "string",
          "default": "chat",
          "description": "The Herdr mod that shows the new agent as a chat: `chat` of herdr-chat, or the name of a fork of it. The agent starts in a terminal when this mod is not installed, when the agent is not `claude`, `codex`, or `pi`, or when this setting is empty."
        }
      }
    },
    "commands": [
      {
        "command": "herdrComments.add",
        "title": "Add Herdr Comment",
        "category": "Herdr Comments"
      },
      {
        "command": "herdrComments.addGeneral",
        "title": "Add General Herdr Comment",
        "category": "Herdr Comments"
      },
      {
        "command": "herdrComments.addGeneralFromView",
        "title": "Add General Comment",
        "category": "Herdr Comments",
        "icon": "$(add)"
      },
      {
        "command": "herdrComments.addGeneralFromGitChanges",
        "title": "Add General Herdr Comment",
        "category": "Herdr Comments",
        "icon": "$(add)"
      },
      {
        "command": "herdrComments.submit",
        "title": "Submit Comments",
        "category": "Herdr Comments",
        "icon": "$(send)",
        "enablement": "herdrComments.canSubmit"
      },
      {
        "command": "herdrComments.start",
        "title": "Start an Agent with These Comments",
        "category": "Herdr Comments",
        "icon": "$(rocket)",
        "enablement": "herdrComments.canSubmit"
      },
      {
        "command": "herdrComments.chooseAgent",
        "title": "Choose the Agent",
        "category": "Herdr Comments",
        "icon": "$(person)"
      },
      {
        "command": "herdrComments.save",
        "title": "Add Comment"
      },
      {
        "command": "herdrComments.cancelNew",
        "title": "Cancel"
      },
      {
        "command": "herdrComments.edit",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "herdrComments.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "herdrComments.saveEdit",
        "title": "Save"
      },
      {
        "command": "herdrComments.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "herdrComments.reveal",
        "title": "Show the Comment"
      }
    ],
    "keybindings": [
      {
        "command": "herdrComments.add",
        "key": "ctrl+shift+c",
        "when": "editorTextFocus && activeCursorHasCommentingRange"
      },
      {
        "command": "herdrComments.addGeneral",
        "key": "ctrl+shift+c",
        "when": "editorTextFocus && !activeCursorHasCommentingRange && !commentEditorFocused && (resourceScheme != file || isInDiffLeftEditor)"
      },
      {
        "command": "herdrComments.addGeneral",
        "args": {
          "back": "workbench.action.focusSideBar"
        },
        "key": "ctrl+shift+c",
        "when": "sideBarFocus && !editorTextFocus && !terminalFocus"
      },
      {
        "command": "herdrComments.addGeneral",
        "args": {
          "back": "workbench.action.focusAuxiliaryBar"
        },
        "key": "ctrl+shift+c",
        "when": "auxiliaryBarFocus && !editorTextFocus && !terminalFocus"
      },
      {
        "command": "herdrComments.addGeneral",
        "args": {
          "back": "workbench.action.focusPanel"
        },
        "key": "ctrl+shift+c",
        "when": "panelFocus && !editorTextFocus && !terminalFocus"
      },
      {
        "command": "herdrComments.addGeneral",
        "key": "ctrl+shift+c",
        "when": "!editorTextFocus && !sideBarFocus && !auxiliaryBarFocus && !panelFocus && !terminalFocus && !commentEditorFocused"
      },
      {
        "command": "editor.action.submitComment",
        "key": "enter",
        "when": "commentEditorFocused && commentController == herdrComments"
      },
      {
        "command": "type",
        "args": {
          "text": "\n"
        },
        "key": "shift+enter",
        "when": "commentEditorFocused && commentController == herdrComments"
      },
      {
        "command": "type",
        "args": {
          "text": "\n"
        },
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "commentEditorFocused && commentController == herdrComments"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "herdrComments.pending",
          "name": "Herdr Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "herdrComments.pending",
        "contents": "No pending comments.\nPut the cursor on a line or select some lines, then click + in the gutter or press ⌃⇧C.\nFor a general comment, on no file, click + above or press ⌃⇧C outside an editor."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "herdrComments.save",
          "when": "false"
        },
        {
          "command": "herdrComments.cancelNew",
          "when": "false"
        },
        {
          "command": "herdrComments.edit",
          "when": "false"
        },
        {
          "command": "herdrComments.delete",
          "when": "false"
        },
        {
          "command": "herdrComments.saveEdit",
          "when": "false"
        },
        {
          "command": "herdrComments.cancelEdit",
          "when": "false"
        },
        {
          "command": "herdrComments.reveal",
          "when": "false"
        },
        {
          "command": "herdrComments.addGeneralFromView",
          "when": "false"
        },
        {
          "command": "herdrComments.addGeneralFromGitChanges",
          "when": "false"
        },
        {
          "command": "herdrComments.start",
          "when": "herdrComments.startsAgent"
        },
        {
          "command": "herdrComments.submit",
          "when": "!herdrComments.startsAgent"
        }
      ],
      "view/title": [
        {
          "command": "herdrComments.addGeneralFromView",
          "when": "view == herdrComments.pending",
          "group": "navigation@0"
        },
        {
          "command": "herdrComments.addGeneralFromGitChanges",
          "when": "view == gitChanges.files",
          "group": "navigation@2"
        },
        {
          "command": "herdrComments.submit",
          "when": "view == herdrComments.pending && !herdrComments.startsAgent",
          "group": "navigation@2"
        },
        {
          "command": "herdrComments.start",
          "when": "view == herdrComments.pending && herdrComments.startsAgent",
          "group": "navigation@2"
        },
        {
          "command": "herdrComments.chooseAgent",
          "when": "view == herdrComments.pending && herdrComments.hasCandidates",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "herdrComments.edit",
          "when": "view == herdrComments.pending && viewItem == herdrComment",
          "group": "inline@1"
        },
        {
          "command": "herdrComments.delete",
          "when": "view == herdrComments.pending && viewItem == herdrComment",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "herdrComments.save",
          "when": "commentController == herdrComments && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "herdrComments.cancelNew",
          "when": "commentController == herdrComments && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "herdrComments.edit",
          "when": "commentController == herdrComments",
          "group": "inline@1"
        },
        {
          "command": "herdrComments.delete",
          "when": "commentController == herdrComments",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "herdrComments.saveEdit",
          "when": "commentController == herdrComments",
          "group": "inline@1"
        },
        {
          "command": "herdrComments.cancelEdit",
          "when": "commentController == herdrComments",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "node -e \"require('node:fs').mkdirSync('releases', { recursive: true })\"",
    "package": "npx @vscode/vsce package --out releases"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
